# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SQLite database file path (optional, defaults to ./data/ajentir.sqlite)
AJENTIR_DB_PATH=

# Optional: Set an explicit Team Portal owner password & email (or claim on first login)
ADMIN_PASSWORD=
ADMIN_OWNER_EMAIL=dejawoot99@gmail.com

# Optional: Server-side inquiry alert notifications (keep private on server)
RESEND_API_KEY=
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=
RESEND_SEND_AUTO_REPLY=false
ALERT_WEBHOOK_URL=
