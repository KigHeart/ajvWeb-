# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional: Server-side inquiry alert notifications (keep private on server)
RESEND_API_KEY=
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=
RESEND_SEND_AUTO_REPLY=false
ALERT_WEBHOOK_URL=

# Optional: Public Firebase App Check reCAPTCHA v3 site key (safe for browser)
VITE_RECAPTCHA_SITE_KEY=
