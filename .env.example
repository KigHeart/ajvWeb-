# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SQLite database file path (optional, defaults to ./data/ajentir.sqlite)
AJENTIR_DB_PATH=

# Optional: Set an explicit Team Portal owner password & email (or claim on first login)
ADMIN_PASSWORD=
ADMIN_OWNER_EMAIL=dejawoot99@gmail.com

# Optional: Server-side inquiry alert notifications (keep private on server)
RESEND_API_KEY=
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=
RESEND_SEND_AUTO_REPLY=false
ALERT_WEBHOOK_URL=

# Frontend build-time API origin. Set VITE_API_BASE_URL to the deployed API origin
# in the GitHub Pages build environment (for example, https://your-api-host.example).
VITE_API_BASE_URL=

# Allowed browser origins for the Venture Desk API (comma-separated).
# GitHub Pages origin is allowed by default; add custom domains here.
CORS_ORIGINS=

# Venture Desk private workspace API (required to unlock /venture-desk).
# Generate a unique secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VENTURE_DESK_KEY=replace-with-a-random-secret-of-at-least-32-characters
# Keep Venture Desk records separate from public inquiry records.
VENTURE_DESK_DB_PATH=./data/venture-desk.sqlite
