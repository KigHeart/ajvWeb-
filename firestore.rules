rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailId(id) {
      return id is string
        && id.size() >= 3
        && id.size() <= 160
        && id.matches('^[^\\s@/]+@[^\\s@/]+\\.[^\\s@/]+$');
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'dejawoot99@gmail.com';
    }

    function isInvitedAdmin() {
      return isSignedIn()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/admin_invites/$(request.auth.token.email));
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)))
        || isInvitedAdmin();
    }

    function isValidLanePair(lane, subTrack) {
      return (lane == 'founder' && subTrack in ['investment', 'incubation'])
        || (lane == 'training' && subTrack in ['governance', 'workflow', 'workshop'])
        || (lane == 'partner' && subTrack in ['discovery', 'model-provider', 'bank', 'enterprise']);
    }

    function isIntInRange(val, minVal, maxVal) {
      return val is int && val >= minVal && val <= maxVal;
    }

    // 3. Entity Validation Blueprints
    function isValidInquiry(data) {
      return data.keys().hasAll([
          'lane',
          'subTrack',
          'fullName',
          'company',
          'email',
          'website',
          'teamSize',
          'message',
          'status',
          'stageTag',
          'designPartner',
          'notes',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'lane',
          'subTrack',
          'fullName',
          'company',
          'email',
          'website',
          'teamSize',
          'message',
          'status',
          'stageTag',
          'designPartner',
          'notes',
          'createdAt',
          'updatedAt'
        ])
        && data.lane is string
        && data.lane in ['founder', 'training', 'partner']
        && data.subTrack is string
        && isValidLanePair(data.lane, data.subTrack)
        && data.fullName is string
        && data.fullName.size() >= 1
        && data.fullName.size() <= 120
        && data.company is string
        && data.company.size() <= 140
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.website is string
        && data.website.size() <= 300
        && (data.website == '' || data.website.matches('^https?://.*'))
        && data.teamSize is string
        && data.teamSize.size() <= 40
        && data.teamSize in ['', '1-10 leaders', '11-30 leaders', '30+ leaders']
        && data.message is string
        && data.message.size() <= 2000
        && data.status is string
        && data.status in ['new', 'reviewing', 'scheduled', 'archived']
        && data.stageTag is string
        && data.stageTag.size() <= 40
        && data.stageTag in ['', 'Concept', 'MVP', 'Revenue', 'Pilot Ready', 'Credit Pool', 'Cohort']
        && data.designPartner is string
        && data.designPartner.size() <= 140
        && data.notes is string
        && data.notes.size() <= 2000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'displayName', 'role', 'createdAt'])
        && data.keys().hasOnly(['email', 'displayName', 'role', 'createdAt'])
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.role is string
        && data.role == 'admin'
        && data.createdAt is timestamp;
    }

    function isValidAdminInvite(data, emailId) {
      return data.keys().hasAll(['email', 'displayName', 'role', 'addedBy', 'createdAt'])
        && data.keys().hasOnly(['email', 'displayName', 'role', 'addedBy', 'createdAt'])
        && data.email is string
        && data.email == emailId
        && data.email.size() >= 3
        && data.email.size() <= 160
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.role is string
        && data.role == 'admin'
        && data.addedBy is string
        && data.addedBy.size() >= 3
        && data.addedBy.size() <= 160
        && data.createdAt is timestamp;
    }

    function isValidSiteConfig(data) {
      return data.keys().hasAll([
          'incubationStatus',
          'nextBriefingLabel',
          'partnerSandboxNote',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'incubationStatus',
          'nextBriefingLabel',
          'partnerSandboxNote',
          'updatedAt'
        ])
        && data.incubationStatus is string
        && data.incubationStatus.size() <= 30
        && data.incubationStatus in ['Open', 'By Intro', 'Waitlist']
        && data.nextBriefingLabel is string
        && data.nextBriefingLabel.size() <= 120
        && data.partnerSandboxNote is string
        && data.partnerSandboxNote.size() <= 160
        && data.updatedAt is timestamp;
    }

    function isValidDiscoveryOrg(data) {
      return data.keys().hasAll([
          'name',
          'sector',
          'size',
          'operatingModel',
          'workflowOwners',
          'workflowsSummary',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'name',
          'sector',
          'size',
          'operatingModel',
          'workflowOwners',
          'workflowsSummary',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 140
        && data.sector is string
        && data.sector in [
          'Financial services',
          'Agriculture',
          'Logistics',
          'Healthcare',
          'Retail & distribution',
          'Professional services',
          'Construction',
          'Other'
        ]
        && data.size is string
        && data.size.size() <= 60
        && data.operatingModel is string
        && data.operatingModel.size() <= 240
        && data.workflowOwners is string
        && data.workflowOwners.size() <= 200
        && data.workflowsSummary is string
        && data.workflowsSummary.size() <= 3000
        && data.status is string
        && data.status in ['Access', 'Mapping', 'Decomposing', 'Completed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVentureOpportunity(data) {
      return data.keys().hasAll([
          'title',
          'orgId',
          'orgName',
          'category',
          'intervention',
          'problemSummary',
          'validationEvidence',
          'hasPaidDemandEvidence',
          'scoreSeverity',
          'scoreRepeatability',
          'scoreWtp',
          'scoreAgentic',
          'scoreScalability',
          'scoreFeasibility',
          'scoreFit',
          'pipelineStage',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'title',
          'orgId',
          'orgName',
          'category',
          'intervention',
          'problemSummary',
          'validationEvidence',
          'hasPaidDemandEvidence',
          'scoreSeverity',
          'scoreRepeatability',
          'scoreWtp',
          'scoreAgentic',
          'scoreScalability',
          'scoreFeasibility',
          'scoreFit',
          'pipelineStage',
          'createdAt',
          'updatedAt'
        ])
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 140
        && data.orgId is string
        && data.orgId.size() <= 128
        && (data.orgId == '' || (isValidId(data.orgId) && exists(/databases/$(database)/documents/discovery_orgs/$(data.orgId))))
        && data.orgName is string
        && data.orgName.size() <= 140
        && data.category is string
        && data.category in [
          'A — Internal transformation',
          'B — Replicable product',
          'C — New venture'
        ]
        && data.intervention is string
        && data.intervention in ['Eliminate', 'Simplify', 'Augment', 'Delegate', 'Reconstruct']
        && data.problemSummary is string
        && data.problemSummary.size() <= 1200
        && data.validationEvidence is string
        && data.validationEvidence.size() <= 1200
        && data.hasPaidDemandEvidence is bool
        && isIntInRange(data.scoreSeverity, 0, 15)
        && isIntInRange(data.scoreRepeatability, 0, 15)
        && isIntInRange(data.scoreWtp, 0, 20)
        && isIntInRange(data.scoreAgentic, 0, 15)
        && isIntInRange(data.scoreScalability, 0, 15)
        && isIntInRange(data.scoreFeasibility, 0, 10)
        && isIntInRange(data.scoreFit, 0, 10)
        && data.pipelineStage is string
        && data.pipelineStage in ['Reject', 'Investigate', 'Validate', 'Incubate', 'Invest']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Inquiries Collection
    match /inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && isAdmin();
      allow list: if isAdmin();

      allow create: if isValidId(inquiryId)
        && isValidInquiry(incoming())
        && incoming().status == 'new'
        && incoming().stageTag == ''
        && incoming().designPartner == ''
        && incoming().notes == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(inquiryId)
        && isAdmin()
        && isValidInquiry(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'stageTag',
          'designPartner',
          'notes',
          'updatedAt'
        ]);

      allow delete: if isValidId(inquiryId) && isAdmin();
    }

    // 5. Admins Collection (UID-based)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isAdmin() || (isSignedIn() && request.auth.uid == adminId));
      allow list: if isAdmin();
      allow create: if isValidId(adminId)
        && isBootstrappedAdmin()
        && isValidAdminUser(incoming())
        && incoming().createdAt == request.time;
      allow update: if isValidId(adminId)
        && isBootstrappedAdmin()
        && isValidAdminUser(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName']);
      allow delete: if isValidId(adminId) && isBootstrappedAdmin();
    }

    // 6. Admin Invites Collection (Email-based team access)
    match /admin_invites/{emailId} {
      allow get: if isValidEmailId(emailId)
        && (isBootstrappedAdmin() || (isSignedIn() && request.auth.token.email == emailId));
      allow list: if isBootstrappedAdmin();
      allow create: if isValidEmailId(emailId)
        && isBootstrappedAdmin()
        && isValidAdminInvite(incoming(), emailId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidEmailId(emailId) && isBootstrappedAdmin();
    }

    // 7. Public Site Config (Dynamic Cohort & Briefing Labels)
    match /public_config/{configId} {
      allow get: if configId == 'site';
      allow list: if false;
      allow create, update: if configId == 'site'
        && isAdmin()
        && isValidSiteConfig(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // 8. Discovery Organisations (Admin-Only Internal OS)
    match /discovery_orgs/{orgId} {
      allow get: if isValidId(orgId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(orgId)
        && isAdmin()
        && isValidDiscoveryOrg(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(orgId)
        && isAdmin()
        && isValidDiscoveryOrg(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'sector',
          'size',
          'operatingModel',
          'workflowOwners',
          'workflowsSummary',
          'status',
          'updatedAt'
        ]);
      allow delete: if isValidId(orgId) && isAdmin();
    }

    // 9. Venture Opportunities & 100-Point Scorecard (Admin-Only Internal OS)
    match /venture_opportunities/{oppId} {
      allow get: if isValidId(oppId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(oppId)
        && isAdmin()
        && isValidVentureOpportunity(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(oppId)
        && isAdmin()
        && isValidVentureOpportunity(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'orgId',
          'orgName',
          'category',
          'intervention',
          'problemSummary',
          'validationEvidence',
          'hasPaidDemandEvidence',
          'scoreSeverity',
          'scoreRepeatability',
          'scoreWtp',
          'scoreAgentic',
          'scoreScalability',
          'scoreFeasibility',
          'scoreFit',
          'pipelineStage',
          'updatedAt'
        ]);
      allow delete: if isValidId(oppId) && isAdmin();
    }
  }
}
