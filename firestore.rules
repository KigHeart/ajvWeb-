rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'dejawoot99@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidLanePair(lane, subTrack) {
      return (lane == 'founder' && subTrack in ['investment', 'incubation'])
        || (lane == 'training' && subTrack in ['governance', 'workflow', 'workshop'])
        || (lane == 'partner' && subTrack in ['model-provider', 'bank', 'enterprise']);
    }

    // 3. Entity Validation Blueprints
    function isValidInquiry(data) {
      return data.keys().hasAll([
          'lane',
          'subTrack',
          'fullName',
          'company',
          'email',
          'website',
          'message',
          'status',
          'notes',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'lane',
          'subTrack',
          'fullName',
          'company',
          'email',
          'website',
          'message',
          'status',
          'notes',
          'createdAt',
          'updatedAt'
        ])
        && data.lane is string
        && data.lane in ['founder', 'training', 'partner']
        && data.subTrack is string
        && isValidLanePair(data.lane, data.subTrack)
        && data.fullName is string
        && data.fullName.size() >= 1
        && data.fullName.size() <= 120
        && data.company is string
        && data.company.size() <= 140
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.website is string
        && data.website.size() <= 300
        && (data.website == '' || data.website.matches('^https?://.*'))
        && data.message is string
        && data.message.size() <= 2000
        && data.status is string
        && data.status in ['new', 'reviewing', 'scheduled', 'archived']
        && data.notes is string
        && data.notes.size() <= 2000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'displayName', 'role', 'createdAt'])
        && data.keys().hasOnly(['email', 'displayName', 'role', 'createdAt'])
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.role is string
        && data.role == 'admin'
        && data.createdAt is timestamp;
    }

    // 4. Inquiries Collection
    match /inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && isAdmin();
      allow list: if isAdmin();

      allow create: if isValidId(inquiryId)
        && isValidInquiry(incoming())
        && incoming().status == 'new'
        && incoming().notes == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(inquiryId)
        && isAdmin()
        && isValidInquiry(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt']);

      allow delete: if isValidId(inquiryId) && isAdmin();
    }

    // 5. Admins Collection
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isAdmin() || (isSignedIn() && request.auth.uid == adminId));
      allow list: if isAdmin();
      allow create: if isValidId(adminId)
        && isBootstrappedAdmin()
        && isValidAdminUser(incoming())
        && incoming().createdAt == request.time;
      allow update: if isValidId(adminId)
        && isBootstrappedAdmin()
        && isValidAdminUser(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName']);
      allow delete: if isValidId(adminId) && isBootstrappedAdmin();
    }
  }
}
