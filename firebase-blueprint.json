{
  "entities": {
    "Inquiry": {
      "title": "Inquiry",
      "description": "Inbound inquiry submitted through the Ajentir Ventures website across Founders, Training, or Partners lanes.",
      "type": "object",
      "properties": {
        "lane": {
          "type": "string",
          "enum": ["founder", "training", "partner"],
          "description": "Top-level stakeholder lane."
        },
        "subTrack": {
          "type": "string",
          "enum": [
            "investment",
            "incubation",
            "discovery",
            "governance",
            "workflow",
            "workshop",
            "model-provider",
            "bank",
            "enterprise"
          ],
          "description": "Specific program, discovery, or partnership sub-track."
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Submitter full name."
        },
        "company": {
          "type": "string",
          "maxLength": 140,
          "description": "Organisation, startup, SME, or bank name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "description": "Contact email address."
        },
        "website": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional website, brief, or LinkedIn URL."
        },
        "teamSize": {
          "type": "string",
          "enum": ["", "1-10 leaders", "11-30 leaders", "30+ leaders"],
          "maxLength": 40,
          "description": "Optional leadership cohort size for Executive Training."
        },
        "message": {
          "type": "string",
          "maxLength": 2000,
          "description": "Inquiry summary or collaboration scope."
        },
        "status": {
          "type": "string",
          "enum": ["new", "reviewing", "scheduled", "archived"],
          "description": "Internal triage status managed by Ajentir Ventures admins."
        },
        "stageTag": {
          "type": "string",
          "enum": [
            "",
            "Concept",
            "MVP",
            "Revenue",
            "Pilot Ready",
            "Credit Pool",
            "Cohort"
          ],
          "maxLength": 40,
          "description": "Pipeline stage or priority tag managed by admins."
        },
        "designPartner": {
          "type": "string",
          "maxLength": 140,
          "description": "Matched SME or commercial bank design partner (admin-managed)."
        },
        "notes": {
          "type": "string",
          "maxLength": 2000,
          "description": "Internal review notes written by Ajentir Ventures admins."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": [
        "lane",
        "subTrack",
        "fullName",
        "company",
        "email",
        "website",
        "teamSize",
        "message",
        "status",
        "stageTag",
        "designPartner",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "UID-keyed Ajentir Ventures admin record.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "displayName", "role", "createdAt"]
    },
    "AdminInvite": {
      "title": "AdminInvite",
      "description": "Email-keyed team member authorized to access the Ajentir Ventures Portal.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        },
        "addedBy": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "displayName", "role", "addedBy", "createdAt"]
    },
    "SiteConfig": {
      "title": "SiteConfig",
      "description": "Publicly readable live cohort & briefing labels editable from the Admin Portal.",
      "type": "object",
      "properties": {
        "incubationStatus": {
          "type": "string",
          "enum": ["Open", "By Intro", "Waitlist"],
          "maxLength": 30
        },
        "nextBriefingLabel": {
          "type": "string",
          "maxLength": 120
        },
        "partnerSandboxNote": {
          "type": "string",
          "maxLength": 160
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "incubationStatus",
        "nextBriefingLabel",
        "partnerSandboxNote",
        "updatedAt"
      ]
    },
    "DiscoveryOrg": {
      "title": "DiscoveryOrg",
      "description": "Internal organisation profile and workflow inventory tracked inside Ajentir Venture Discovery System v1.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "sector": {
          "type": "string",
          "enum": [
            "Financial services",
            "Agriculture",
            "Logistics",
            "Healthcare",
            "Retail & distribution",
            "Professional services",
            "Construction",
            "Other"
          ]
        },
        "size": {
          "type": "string",
          "maxLength": 60
        },
        "operatingModel": {
          "type": "string",
          "maxLength": 240
        },
        "workflowOwners": {
          "type": "string",
          "maxLength": 200
        },
        "workflowsSummary": {
          "type": "string",
          "maxLength": 3000
        },
        "status": {
          "type": "string",
          "enum": ["Access", "Mapping", "Decomposing", "Completed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "sector",
        "size",
        "operatingModel",
        "workflowOwners",
        "workflowsSummary",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "VentureOpportunity": {
      "title": "VentureOpportunity",
      "description": "Internal opportunity register, 100-point scorecard, validation evidence, and pipeline stage.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "orgId": {
          "type": "string",
          "maxLength": 128
        },
        "orgName": {
          "type": "string",
          "maxLength": 140
        },
        "category": {
          "type": "string",
          "enum": [
            "A — Internal transformation",
            "B — Replicable product",
            "C — New venture"
          ]
        },
        "intervention": {
          "type": "string",
          "enum": ["Eliminate", "Simplify", "Augment", "Delegate", "Reconstruct"]
        },
        "problemSummary": {
          "type": "string",
          "maxLength": 1200
        },
        "validationEvidence": {
          "type": "string",
          "maxLength": 1200
        },
        "hasPaidDemandEvidence": {
          "type": "boolean"
        },
        "scoreSeverity": { "type": "integer" },
        "scoreRepeatability": { "type": "integer" },
        "scoreWtp": { "type": "integer" },
        "scoreAgentic": { "type": "integer" },
        "scoreScalability": { "type": "integer" },
        "scoreFeasibility": { "type": "integer" },
        "scoreFit": { "type": "integer" },
        "pipelineStage": {
          "type": "string",
          "enum": ["Reject", "Investigate", "Validate", "Incubate", "Invest"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "title",
        "orgId",
        "orgName",
        "category",
        "intervention",
        "problemSummary",
        "validationEvidence",
        "hasPaidDemandEvidence",
        "scoreSeverity",
        "scoreRepeatability",
        "scoreWtp",
        "scoreAgentic",
        "scoreScalability",
        "scoreFeasibility",
        "scoreFit",
        "pipelineStage",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Publicly creatable (schema-validated) inquiry submissions readable and triaged solely by verified admins."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "UID-keyed Ajentir Ventures admin roster."
    },
    "/admin_invites/{emailId}": {
      "schema": { "$ref": "#/entities/AdminInvite" },
      "description": "Email-keyed admin allowlist managed by the account owner."
    },
    "/public_config/{configId}": {
      "schema": { "$ref": "#/entities/SiteConfig" },
      "description": "Single live site configuration document ('site') readable publicly and editable only by verified admins."
    },
    "/discovery_orgs/{orgId}": {
      "schema": { "$ref": "#/entities/DiscoveryOrg" },
      "description": "Admin-only organisation profiles and workflow capture inventories."
    },
    "/venture_opportunities/{oppId}": {
      "schema": { "$ref": "#/entities/VentureOpportunity" },
      "description": "Admin-only opportunity register, 100-point scorecard, validation tracker, and venture pipeline."
    }
  }
}
