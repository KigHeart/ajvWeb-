{
  "entities": {
    "Inquiry": {
      "title": "Inquiry",
      "description": "Inbound inquiry submitted through the Ajentir Ventures website across Founders, Training, or Partners lanes.",
      "type": "object",
      "properties": {
        "lane": {
          "type": "string",
          "enum": ["founder", "training", "partner"],
          "description": "Top-level stakeholder lane."
        },
        "subTrack": {
          "type": "string",
          "enum": [
            "investment",
            "incubation",
            "governance",
            "workflow",
            "workshop",
            "model-provider",
            "bank",
            "enterprise"
          ],
          "description": "Specific program or partnership sub-track."
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Submitter full name."
        },
        "company": {
          "type": "string",
          "maxLength": 140,
          "description": "Organisation, startup, SME, or bank name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "description": "Contact email address."
        },
        "website": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional website, brief, or LinkedIn URL."
        },
        "teamSize": {
          "type": "string",
          "enum": ["", "1-10 leaders", "11-30 leaders", "30+ leaders"],
          "maxLength": 40,
          "description": "Optional leadership cohort size for Executive Training."
        },
        "preferredSession": {
          "type": "string",
          "maxLength": 140,
          "description": "Optional preferred upcoming Executive Training briefing session label."
        },
        "message": {
          "type": "string",
          "maxLength": 2000,
          "description": "Inquiry summary or collaboration scope."
        },
        "status": {
          "type": "string",
          "enum": ["new", "reviewing", "scheduled", "archived"],
          "description": "Internal triage status managed by Ajentir Ventures admins."
        },
        "stageTag": {
          "type": "string",
          "enum": [
            "",
            "Concept",
            "MVP",
            "Revenue",
            "Pilot Ready",
            "Credit Pool",
            "Cohort"
          ],
          "maxLength": 40,
          "description": "Pipeline stage or priority tag managed by admins."
        },
        "designPartner": {
          "type": "string",
          "maxLength": 140,
          "description": "Matched SME or commercial bank design partner (admin-managed)."
        },
        "notes": {
          "type": "string",
          "maxLength": 2000,
          "description": "Internal review notes written by Ajentir Ventures admins."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": [
        "lane",
        "subTrack",
        "fullName",
        "company",
        "email",
        "website",
        "teamSize",
        "preferredSession",
        "message",
        "status",
        "stageTag",
        "designPartner",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "InquiryActivity": {
      "title": "InquiryActivity",
      "description": "Immutable chronological triage log entry inside an inquiry subcollection.",
      "type": "object",
      "properties": {
        "actorEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["actorEmail", "summary", "createdAt"]
    },
    "BriefingSession": {
      "title": "BriefingSession",
      "description": "Scheduled SME Executive Training briefing session managed by admins and selectable in Training inquiries.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "scheduleLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "format": {
          "type": "string",
          "enum": ["Nairobi · In-Person", "Virtual · Live", "Hybrid"],
          "maxLength": 40
        },
        "seatsLabel": {
          "type": "string",
          "maxLength": 60
        },
        "isOpen": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "title",
        "scheduleLabel",
        "format",
        "seatsLabel",
        "isOpen",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "UID-keyed Ajentir Ventures admin record.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "displayName", "role", "createdAt"]
    },
    "AdminInvite": {
      "title": "AdminInvite",
      "description": "Email-keyed team member authorized to access the Ajentir Ventures Portal.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        },
        "addedBy": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "displayName", "role", "addedBy", "createdAt"]
    },
    "SiteConfig": {
      "title": "SiteConfig",
      "description": "Publicly readable live cohort & briefing labels editable from the Admin Portal.",
      "type": "object",
      "properties": {
        "incubationStatus": {
          "type": "string",
          "enum": ["Open", "By Intro", "Waitlist"],
          "maxLength": 30
        },
        "nextBriefingLabel": {
          "type": "string",
          "maxLength": 120
        },
        "partnerSandboxNote": {
          "type": "string",
          "maxLength": 160
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "incubationStatus",
        "nextBriefingLabel",
        "partnerSandboxNote",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Publicly creatable (schema-validated) inquiry submissions readable and triaged solely by verified admins."
    },
    "/inquiries/{inquiryId}/activity/{activityId}": {
      "schema": { "$ref": "#/entities/InquiryActivity" },
      "description": "Immutable admin triage activity log under each inquiry."
    },
    "/briefing_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/BriefingSession" },
      "description": "Executive Training briefing sessions; open sessions are readable publicly and all sessions are admin-managed."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "UID-keyed Ajentir Ventures admin roster."
    },
    "/admin_invites/{emailId}": {
      "schema": { "$ref": "#/entities/AdminInvite" },
      "description": "Email-keyed admin allowlist managed by the account owner."
    },
    "/public_config/{configId}": {
      "schema": { "$ref": "#/entities/SiteConfig" },
      "description": "Single live site configuration document ('site') readable publicly and editable only by verified admins."
    }
  }
}
